{
  "name": "r2client",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @r2client/desktop build",
    "check": "tsc --noEmit && vp lint",
    "format": "vp fmt",
    "test": "tsx --test tests/*.test.ts",
    "desktop:dev": "pnpm build && pnpm --filter @r2client/desktop start",
    "desktop:package": "pnpm build && pnpm --filter @r2client/desktop package",
    "test:renderer": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24",
    "tsx": "latest",
    "typescript": "~5.9.3",
    "vite-plus": "latest"
  },
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@10.33.2"
}
