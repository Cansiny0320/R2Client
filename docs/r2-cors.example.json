[
  {
    "AllowedOrigins": ["https://r2.example.com"],
    "AllowedMethods": ["GET", "HEAD", "PUT", "POST", "DELETE"],
    "AllowedHeaders": ["*", "Authorization"],
    "ExposeHeaders": [
      "*",
      "ETag",
      "Content-Length",
      "Content-Range",
      "Accept-Ranges",
      "Content-Type",
      "Last-Modified",
      "Cache-Control",
      "Content-Disposition",
      "x-amz-storage-class",
      "x-amz-meta-r2client-job"
    ],
    "MaxAgeSeconds": 300
  }
]
